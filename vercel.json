{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/features", "destination": "/features.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/flipkart-sales-report-analysis", "destination": "/blog/flipkart-sales-report-analysis.html" },
    { "source": "/blog/flipkart-return-report-analysis", "destination": "/blog/flipkart-return-report-analysis.html" },
    { "source": "/blog/flipkart-sku-analysis", "destination": "/blog/flipkart-sku-analysis.html" },
    { "source": "/blog/flipkart-rto-analysis", "destination": "/blog/flipkart-rto-analysis.html" },
    { "source": "/blog/flipkart-revenue-leakage", "destination": "/blog/flipkart-revenue-leakage.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/google03f3c9cd1704ed2d.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
